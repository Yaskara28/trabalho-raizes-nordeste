{
  "info": {
    "name": "Raízes do Nordeste - API Corrigida",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "T01 - Login válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@raizes.com\", \"senha\": \"123456\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "T02 - Sem token 401",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "T03 - Perfil sem permissão (403)",
          "item": [
            {
              "name": "Login Cliente",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"email\": \"cliente@raizes.com\", \"senha\": \"123456\"}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Login do cliente 200', () => pm.response.to.have.status(200));",
                      "pm.collectionVariables.set('clientToken', pm.response.json().token);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Acesso proibido",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{clientToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pedidos",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "pedidos"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status 403', () => pm.response.to.have.status(403));"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Produtos",
      "item": [
        {
          "name": "T04 - Listar produtos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/produtos?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produtos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "T09 - Produto inexistente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/produtos/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produtos",
                "9999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Pedidos",
      "item": [
        {
          "name": "T05 - Criar pedido válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"canalPedido\": \"TOTEM\", \"clienteId\": 2, \"unidadeId\": 1, \"itens\": [{\"produtoId\": 1, \"quantidade\": 2}], \"formaPagamento\": \"MOCK\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('pedidoId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "T06 - Filtro por canalPedido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos?canalPedido=TOTEM",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ],
              "query": [
                {
                  "key": "canalPedido",
                  "value": "TOTEM"
                }
              ]
            }
          }
        },
        {
          "name": "T07 - canalPedido ausente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"clienteId\": 2, \"unidadeId\": 1, \"itens\": [{\"produtoId\": 1, \"quantidade\": 1}], \"formaPagamento\": \"MOCK\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "T08 - Quantidade negativa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"canalPedido\": \"APP\", \"clienteId\": 2, \"unidadeId\": 1, \"itens\": [{\"produtoId\": 1, \"quantidade\": -1}], \"formaPagamento\": \"MOCK\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "T10 - Estoque insuficiente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"canalPedido\": \"APP\", \"clienteId\": 2, \"unidadeId\": 1, \"itens\": [{\"produtoId\": 1, \"quantidade\": 9999}], \"formaPagamento\": \"MOCK\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Pagamento",
      "item": [
        {
          "name": "T11 - Pagamento aprovado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "teste-aprovado-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"pedidoId\": 1, \"valor\": 37.0, \"resultado\": \"APROVADO\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pagamentos/mock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pagamentos",
                "mock"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "T12 - Pagamento recusado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "teste-recusado-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"pedidoId\": 1, \"valor\": 37.0, \"resultado\": \"RECUSADO\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pagamentos/mock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pagamentos",
                "mock"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 402', () => pm.response.to.have.status(402));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}